# Variáveis do back-end (Spring Boot). Copie para .env e preencha SÓ no servidor. Nunca suba o .env para o GitHub.
# Sem as variáveis de um canal, ele fica em MODO DEMONSTRAÇÃO: pedidos aprovados não são enviados e o registro diz isso.

# Banco de dados (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/elora
DATABASE_USER=elora
DATABASE_PASSWORD=
DATABASE_POOL=20

# Login (OpenID Connect). Vazio = só para desenvolvimento.
OIDC_ISSUER_URI=

# Site público e imobiliária padrão
ELORA_SITE_URL=
ELORA_SITE_NOME=Elora Inteligência Imobiliária
ELORA_TENANT_PADRAO=elora

# WhatsApp Business (API oficial da Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# E-mail (SMTP do domínio da Elora)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Instagram e Facebook (publicação)
META_APP_ID=
META_APP_SECRET=
META_PAGE_TOKEN=

# Anúncios (Meta Ads): leitura de resultados; alteração só com aprovação
META_ADS_TOKEN=
META_ADS_ACCOUNT_ID=

# Agenda (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CRM externo (opcional; o CRM principal é o da própria Elora)
CRM_API_URL=
CRM_API_TOKEN=
