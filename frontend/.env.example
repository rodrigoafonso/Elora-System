# Fonte de dados do front-end: "mock" (dados de exemplo no navegador) ou "api" (back-end Spring Boot).
VITE_DATA_SOURCE=mock
# URL base da API quando VITE_DATA_SOURCE=api (em dev o Vite faz proxy de /api para localhost:8080).
VITE_API_URL=/api/v1
# Imobiliária (tenant) usada em desenvolvimento.
VITE_TENANT_ID=elora
